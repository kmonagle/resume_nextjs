# Neon pooled connection string (via PgBouncer) — used by the app at runtime.
# Get this from the Neon dashboard: Project > Connection Details > "Pooled connection"
DATABASE_URL="postgres://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon direct (non-pooled) connection string — used only for running migrations.
# Get this from the Neon dashboard: Project > Connection Details > "Direct connection"
DIRECT_URL="postgres://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# The app's public base URL, used to build full short links (e.g. https://your-app.onrender.com/r/AbC123).
# Locally this is just your dev server. NEXT_PUBLIC_* values are inlined at BUILD time.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Which implementation serves the link API. Server-side only (no NEXT_PUBLIC_).
#   local  (default) — this app's own Drizzle code
#   remote — an HTTP backend implementing docs/openapi.yaml (not implemented yet)
# Switching backends means changing this and redeploying.
LINK_BACKEND="local"

# Only when LINK_BACKEND=remote:
# LINK_BACKEND_URL="https://your-go-backend.onrender.com"
# Shared secret sent as "Authorization: Bearer <token>". Backends are publicly
# reachable on Render's free tier, so this is what stops strangers from calling
# them with an arbitrary X-Owner-Id. Use a long random value (16+ characters).
# LINK_BACKEND_TOKEN="change-me-to-a-long-random-string"
